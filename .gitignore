# Root .gitignore for MERN Monorepo

# Dependencies
node_modules/
.pnpm-store/

# Environment variables
.env
.env.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
server/public/uploads/*
!server/public/uploads/.gitkeep

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
